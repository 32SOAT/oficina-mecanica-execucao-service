NODE_ENV=development
APP_PORT=3003
SERVICE_NAME=execucao-service

DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=execucao
DYNAMODB_SAGA_COMMANDS_TABLE=execucao_saga_commands
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SAGA_TOKEN=oficina-local

SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
SQS_WORKER_ENABLED=false
SQS_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/oficina-execution-commands.fifo
SQS_RESULTS_QUEUE_URL=http://localhost:4566/000000000000/oficina-os-results.fifo
